<%- include('./includes/head', { siteTitle: '分类 | ' + themeConfig.siteName }) %>

<body>

<%- include('./includes/header') %>

<article class="mod-post mod-post__type-post">

    <header>
        <h1 class="mod-post__title">
            分类
        </h1>
    </header>

    <div class="mod-post__entry wzulli">

        <div class="tags categories">
            <% if (categories.length > 0) { %>
                <ul class="tags-list categories-list">
                    <% categories.forEach(function(category) { %>
                        <li>
                            <a href="<%= category.link %>" rel="category" class="size-10" title="<%= category.count %> 篇文章">
                                <%= category.name %> <span>(<%= category.count %>)</span>
                            </a>
                        </li>
                    <% }); %>
                </ul>
            <% } else { %>
                <li>
                    没有任何分类
                </li>
            <% } %>
        </div>

    </div>

</article>

<%- include('./includes/footer') %>

</body>
</html>
